# =============================================================================
# Suuqa Xirfadaha - Example Environment Configuration
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT
# DO NOT COMMIT REAL SECRET VALUES TO VERSION CONTROL
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Clerk Authentication Credentials
# -----------------------------------------------------------------------------

# Client-side Publishable Key (Required by Vite frontend)
# Local Dev: pk_test_... | Render Prod: pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# Backend Server Secret Key (MUST NEVER BE EXPOSED TO BROWSER / VITE)
# Local Dev: sk_test_... | Render Prod: sk_live_...
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY

# Clerk Environment Mode (development | production)
CLERK_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 2. Database Connection
# -----------------------------------------------------------------------------
# Neon PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 3. Application & Server Settings
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 4. Platform Administration
# -----------------------------------------------------------------------------
# Comma-separated list of email addresses granted auto-admin status
ADMIN_EMAILS=admin@suuqaxirfadaha.app
