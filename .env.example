# DATABASE_URL: Required PostgreSQL connection string.
# Use your Neon connection string in local .env files and deployment secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"

# PORT: Optional. Defaults to 3000.
PORT=3000

# HMR_PORT: Optional Vite websocket port for local development. Defaults to 24678.
HMR_PORT=24678

# Public URL used to build password-reset links.
PUBLIC_APP_URL="http://localhost:3000"

# Optional webhook that delivers password-reset emails.
# It receives JSON: { to, name, resetUrl, expiresInMinutes }.
RESET_WEBHOOK_URL=""
RESET_WEBHOOK_SECRET=""

# Optional persistent local image directory. In production on Render, prefer Cloudinary below.
UPLOAD_DIR="./uploads"

# Optional Cloudinary free-tier image storage. When configured, profile images are stored there.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

